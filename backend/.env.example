# ==================================================
# SISTEMA APR - CONFIGURACAO DA APLICACAO
# ==================================================

APP_NAME=apr_db
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4


# ==================================================
# SEGURANCA DE SENHAS
# ==================================================

BCRYPT_ROUNDS=12


# ==================================================
# CONFIGURACAO DOS LOGS
# ==================================================

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false


# ==================================================
# BANCO DE DADOS - POSTGRESQL
# ==================================================

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=apr_senai
DB_USERNAME=postgres
DB_PASSWORD=


# ==================================================
# SESSOES E SEGURANCA DOS COOKIES
# ==================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SESSION_HTTP_ONLY=true

# false somente para desenvolvimento local via HTTP.
# Em producao com HTTPS, utilizar true.
SESSION_SECURE_COOKIE=false

SESSION_SAME_SITE=lax


# ==================================================
# AUTENTICACAO - LARAVEL SANCTUM
# ==================================================

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5500,127.0.0.1:8000,localhost:5500,localhost:8000

SANCTUM_EXPIRATION=120
SANCTUM_TOKEN_PREFIX=


# ==================================================
# ARMAZENAMENTO E FILAS
# ==================================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database


# ==================================================
# CACHE E RATE LIMITING
# ==================================================

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1


# ==================================================
# REDIS
# ==================================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# ==================================================
# SERVICO DE E-MAIL
# ==================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# ==================================================
# AWS - CONFIGURACAO OPCIONAL
# ==================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ==================================================
# FRONT-END
# ==================================================

VITE_APP_NAME="${APP_NAME}"

